{
  "name": "carscope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.2.17"
  },
  "scripts": {
    "dev": "bun --hot src/server/index.ts",
    "start": "bun scripts/start.ts",
    "build": "bun build src/server/index.ts --target=bun --outdir=dist --production --minify",
    "test": "bun test",
    "typecheck": "bun --bun tsc --noEmit",
    "check": "bun run typecheck && bun test && bun run build",
    "cache:import": "bun scripts/import-cache.ts",
    "smoke": "bun scripts/smoke.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.17",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "bun@1.4.2"
}
