{
  "name": "carscope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.2.17"
  },
  "scripts": {
    "dev": "sh scripts/bun.sh scripts/workspace.ts dev search",
    "dev:report": "sh scripts/bun.sh scripts/workspace.ts dev buying-report",
    "start": "sh scripts/bun.sh scripts/start.ts search",
    "start:report": "sh scripts/bun.sh scripts/start.ts buying-report",
    "build": "sh scripts/bun.sh scripts/workspace.ts build",
    "test": "sh scripts/bun.sh test tests apps/search/tests apps/buying-report/tests",
    "typecheck": "sh scripts/bun.sh --bun tsc --noEmit",
    "format": "sh scripts/bun.sh x biome format --write apps/buying-report",
    "format:check": "sh scripts/bun.sh x biome format apps/buying-report",
    "lint": "sh scripts/bun.sh x biome lint apps/buying-report",
    "check": "sh scripts/bun.sh run format:check && sh scripts/bun.sh run lint && sh scripts/bun.sh run typecheck && sh scripts/bun.sh run test && sh scripts/bun.sh run build",
    "smoke": "sh scripts/bun.sh apps/search/scripts/smoke.ts",
    "smoke:report": "sh scripts/bun.sh apps/buying-report/scripts/smoke.ts",
    "cache:import": "sh scripts/bun.sh apps/search/scripts/import-cache.ts",
    "marketcheck:count": "sh scripts/bun.sh apps/search/scripts/marketcheck-count.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.2.17",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
