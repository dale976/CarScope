# No keys required. Live mode is intentionally rejected in this prototype.
DATA_MODE=mock
HOST=127.0.0.1
PORT=3000
CAR_CACHE_PATH=.cache/cars.json
# Reserved server-only configuration. Supplying a key does NOT enable requests.
MARKETCHECK_LIVE_ENABLED=false
MARKETCHECK_API_KEY=
DVLA_API_KEY=
DVSA_CLIENT_ID=
DVSA_CLIENT_SECRET=
DVSA_API_KEY=
DVSA_TOKEN_URL=
DVSA_SCOPE=

# Offline buying-report app (independent from search PORT)
REPORT_PORT=3001
# Vehicle Data Global sandbox. Keep the key server-side; never expose it to React.
VDG_SANDBOX_ENABLED=false
VDG_API_KEY=
