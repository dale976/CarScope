# Local server
NODE_ENV=development
# mock: offline examples. connected: DVLA/DVSA preview and optional VDG sandbox report.
CARSCOPE_DATA_MODE=mock
HOST=127.0.0.1
PORT=9000
# Temporary compatibility fallback when PORT is unset.
REPORT_PORT=

# Required when NODE_ENV=production and HOST is not loopback.
PUBLIC_ORIGIN=

# Explicit local sandbox report testing only. Never called during preview.
VDG_SANDBOX_ENABLED=false
VDG_API_KEY=

# Optional DVSA MOT History diagnostic command. Keep credentials server-side.
# Used by the diagnostic command and the optional combined free preview.
DVSA_CLIENT_ID=
DVSA_CLIENT_SECRET=
DVSA_API_KEY=
DVSA_SCOPE=https://tapi.dvsa.gov.uk/.default
# Replace TENANT_ID with the tenant supplied in the approval email.
DVSA_TOKEN_URL=https://login.microsoftonline.com/TENANT_ID/oauth2/v2.0/token

# Official free preview in connected mode, never calls VDG.
# Development selects DVLA UAT predefined responses; production selects real VES.
# This selects the DVLA endpoint independently of NODE_ENV and CARSCOPE_DATA_MODE.
DVLA_ENVIRONMENT=development
# Prefer separate keys; DVLA_API_KEY is a compatibility fallback for the selected environment.
DVLA_TEST_API_KEY=
DVLA_PROD_API_KEY=
DVLA_API_KEY=
